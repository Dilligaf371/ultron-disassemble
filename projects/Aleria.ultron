    "4295291236": "\"/opt/homebrew/bin/claude\"",
    "4295326748": "_$s6aleria10IconButtonVSgMd",
    "4295448224": "\"#!/usr/bin/env python3\nimport json, os, socket, sys\n\nSOCK_PATH = os.path.expanduser(\"~/Library/Application Support/Aleria/aleria.sock\")\n\ndef main():\n    raw = sys.stdin.read()\n    if not raw.strip():\n        sys.exit(0)\n    try:\n        payload = json.loads(raw)\n    except Exception:\n        sys.exit(0)\n\n    agent = \"claude\"\n    wait_reply = False\n    args = sys.argv[1:]\n    for i, a in enumerate(args):\n        if a == \"--agent\" and i + 1 < len(args):\n            agent = args[i + 1]\n        elif a in (\"--ask\", \"--wait\"):\n            wait_reply = True\n\n    event_name = payload.get(\"hook_event_name\") or payload.get(\"event\") or \"\"\n    if event_name in (\"PermissionRequest\", \"Stop\") or payload.get(\"tool_name\") == \"AskUserQuestion\":\n        wait_reply = True\n\n    payload[\"ia_agent\"] = agent\n    payload[\"term_program\"] = os.environ.get(\"TERM_PROGRAM\", \"\")\n    payload[\"bundle_id\"] = os.environ.get(\"__CFBundleIdentifier\", \"\")\n\n    if not os.path.exists(SOCK_PATH):\n        sys.exit(0)\n\n    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n    s.settimeout(118.0 if wait_reply else 0.4)\n    try:\n        s.connect(SOCK_PATH)\n        s.sendall((json.dumps(payload) + \"\\n\").encode(\"utf-8\"))\n        if wait_reply:\n            resp = s.recv(16384).decode(\"utf-8\", errors=\"ignore\").strip()\n            if resp:\n                print(resp)\n    except Exception:\n        pass\n    finally:\n        try:\n            s.close()\n        except Exception:\n            pass\n\nif __name__ == \"__main__\":\n    main()\"",
