    "57280": "l_.str.8069.#include <metal_stdlib>\nusing namespace metal;\n\nstruct Uniforms {\n    float4 geometry;   // drawable width, height (px), time (s), grain count\n    float4 weights;    // listening, thinking, speaking, alert\n    float4 pose;       // yaw, pitch, scale, dissolve\n    float4 accent;     // rgb, weight\n    float4 rendering;  // pixel scale, reduce transparency, sleep, voice level\n    float4 phases;     // edge phase, drift phase, disc radius, unused\n};\n\nstruct Grain {\n    float4 position [[position]];\n    float size [[point_size]];\n    float4 color;\n};\n\n// The ALERIA d20 (ParticlesGeometry): a face towards the viewer, apex up; faces and edges back to front.\nconstant float3 kVertices[12] = {\n    {{VERTICES}}\n};\nconstant ushort4 kFaces[20] = { {{FACES}} };      // three vertices + the face's colour\nconstant ushort2 kEdges[30] = { {{EDGES}} };\nconstant float3 kColors[5] = { {{COLORS}} };     // light, red, green, charcoal, far side\nconstant float3 kDisc = {{DISC}};\nconstant float kScale = {{SCALE}};\n\nstatic uint hashBits(uint n) { n ^= n >> 16; n *= 0x7feb352du; n ^= n >> 15; n *= 0x846ca68bu; return n ^ (n >> 16); }\nstatic float rnd(uint n) { return float(hashBits(n)) * (1.0 / 4294967296.0); }\n\n// A smooth, slow field: neighbouring grains travel together.\nstatic float3 flow(float3 p, float t) {\n    return float3(sin(p.y * 2.9 + p.z * 1.4 + t * 0.53) + 0.4 * sin(p.z * 5.3 - t * 0.37),\n                  sin(p.z * 2.7 - p.x * 2.1 + t * 0.41) + 0.4 * sin(p.x * 4.9 + t * 0.29),\n                  sin(p.x * 3.1 + p.y * 1.7 - t * 0.47) + 0.4 * sin(p.y * 5.5 - t * 0.33));\n}\n\nstatic float3 turn(float3 p, float yaw, float pitch) {\n    float cp = cos(pitch), sp = sin(pitch);\n    p = float3(p.x, cp * p.y - sp * p.z, sp * p.y + cp * p.z);\n    float cy = cos(yaw), sy = sin(yaw);\n    return float3(cy * p.x + sy * p.z, p.y, -sy * p.x + cy * p.z);\n}\n\nvertex Grain particlesVertex(uint id [[vertex_id]], constant Uniforms& u [[buffer(0)]]) {\n    Grain out;\n    float count = max(1.0, u.geometry.w);\n    float t = u.geometry.z;\n    float listening = u.weights.x, thinking = u.weights.y, speaking = u.weights.z, alert = u.weights.w;\n    float dissolve = u.pose.w;\n    float sleep = u.rendering.z;\n    float voice = u.rendering.w;\n    bool solid = u.rendering.y > 0.5;\n    uint seed = hashBits(id * 9781u + 6271u);\n    // 12 in 20 grains sit on the faces, 5 on the edges, 3 drift off the faces.\n    uint role = id % 20u;\n    // Ids run back to front through the tables, so nearer grains blend over farther ones.\n    float slot = (float(id) + 0.5) / count;\n\n    float3 p, n, color;\n    float alpha, size;\n    bool edge = role >= 12u && role < 17u;\n    bool drift = role >= 17u;\n    float faceClass = 0.0;\n    if (edge) {\n        ushort2 e = kEdges[min(29u, uint(slot * 30.0))];\n        float3 a = kVertices[e.x], b = kVertices[e.y];\n        // Grains slide along the edges, both ways (mostly while thinking).\n        float s = fract(rnd(seed) + u.phases.x * (rnd(seed + 1u) < 0.5 ? 1.0 : -1.0));\n        n = normalize(a + b);\n        float3 across = normalize(cross(b - a, n));\n        p = mix(a, b, s) + across * (rnd(seed + 2u) - 0.5) * 0.014 + n * (rnd(seed + 3u) - 0.5) * 0.008;\n        color = kColors[0];\n        alpha = 0.36 * (1.0 + 0.5 * listening);\n        size = 1.1;\n    } else {\n        ushort4 f = kFaces[min(19u, uint(slot * 20.0))];\n        float3 a = kVertices[f.x], b = kVertices[f.y], c = kVertices[f.z];\n        float r = sqrt(rnd(seed)), q = rnd(seed + 1u);\n        float3 w = float3(1.0 - r, r * (1.0 - q), r * q);\n        p = a * w.x + b * w.y + c * w.z;\n        n = normalize(a + b + c);\n        p -= n * rnd(seed + 4u) * 0.05;   // a little depth under each face\n        faceClass = float(f.w);\n        color = kColors[f.w];\n        alpha = f.w == 4 ? 0.30 : (f.w == 0 ? 1.6 : 1.2) * (1.0 - 0.30 * dissolve);\n        // Slow patches thin out and fill in again: the faces breathe, more so as they dissolve.\n        float patch = 0.5 + 0.5 * sin(dot(p, float3(3.1, 2.3, 1.7)) + t * 0.31) * cos(dot(p, float3(-1.9, 2.9, 2.2)) - t * 0.27);\n        alpha *= 1.0 - (0.15 + 0.45 * dissolve) * patch;\n        // Close to an edge the colour lightens: the logo's white channels between the faces.\n        float rim = 1.0 - smoothstep(0.0, 0.08, min(w.x, min(w.y, w.z)));\n        color = mix(color, kColors[0], rim * 0.30);\n        size = 1.0;\n        if (drift) {\n            // Shed by the face: out along its normal, carried by the slow field, fading away.\n            float life = fract(rnd(seed + 5u) + u.phases.y * (0.55 + 0.9 * rnd(seed + 6u)));\n            float reach = (0.05 + 0.60 * dissolve) * pow(life, 1.2);\n            float3 carry = flow(p * 1.6 + float3(0.0, 0.0, rnd(seed + 7u) * 3.0), t * 0.25);\n            p += n * reach + carry * (0.04 + 0.22 * dissolve) * life;\n            float wind = thinking * life * 1.2;   // thinking: drifting grains wind about the vertical axis\n            p = float3(cos(wind) * p.x - sin(wind) * p.z, p.y, sin(wind) * p.x + cos(wind) * p.z);\n            alpha = (f.w == 4 ? 0.30 : 1.0) * sin(3.14159265 * life) * (0.40 + 0.60 * dissolve);\n            color = mix(color, kColors[0], 0.5 * life);\n            size = 0.85 + 0.5 * rnd(seed + 8u);\n        }\n    }\n    // Speaking: a soft ripple across the d20 with the voice.\n    float ripple = speaking * voice * 0.045 * (0.5 + 0.5 * sin(dot(n, float3(4.0, 6.0, 3.0)) - t * 5.0));\n    p *= u.pose.z * (1.0 + ripple);\n    p.y *= 1.0 - 0.06 * sleep;\n    p = turn(p, u.pose.x, u.pose.y);\n    float3 normal = turn(n, u.pose.x, u.pose.y);\n\n    float perspective = 3.6 / (3.6 - p.z);\n    float shortest = min(u.geometry.x, u.geometry.y);\n    float2 aspect = shortest / u.geometry.xy;\n    out.position = float4(p.xy * kScale * perspective * aspect, 0.5 - p.z * 0.1, 1.0);\n\n    // Facets catch a little light as the die sways; the far side stays dim.\n    float facing = clamp(0.72 + 0.28 * normal.z + 0.10 * normal.y, 0.35, 1.0);\n    color *= edge ? 1.0 : facing;\n    // The far edges fade: the d20 reads as a solid seen through light, not a wireframe.\n    if (edge) { alpha *= mix(0.15, 1.0, smoothstep(-0.55, 0.30, p.z)); }\n    float pointSize = clamp(size * max(1.0, u.rendering.x * 0.75) * perspective, 0.8, 3.2);\n    out.size = pointSize;\n    // Exposure follows the surface area per grain, so a small notch and a large preview look alike.\n    float density = shortest * shortest / count;\n    float coverage = clamp(density * 1.1 / (pointSize * pointSize), 0.02, 1.0);\n    alpha *= coverage;\n    // Accent (alert red, finished green) on the light: the edges and the white face.\n    float lit = edge ? 1.0 : (faceClass < 0.5 ? 0.8 : 0.25);\n    color = mix(color, u.accent.xyz, u.accent.w * lit);\n    alpha *= 1.0 + 0.18 * alert * sin(t * 2.4);\n    alpha *= 1.0 - 0.5 * sleep;\n    alpha *= 1.0 + 0.35 * speaking * voice;\n    if (solid) {\n        // Reduce Transparency: no shedding, firmer faces on the solid disc.\n        alpha = drift ? 0.0 : min(1.0, alpha * 1.8);\n    }\n    out.color = float4(color, clamp(alpha, 0.0, 1.0));\n    return out;\n}\n\nfragment float4 particlesFragment(Grain grain [[stage_in]], float2 coord [[point_coord]]) {\n    float r = length(coord - 0.5) * 2.0;\n    float alpha = grain.color.a * (1.0 - smoothstep(0.2, 1.0, r));\n    return float4(grain.color.rgb * alpha, alpha);\n}\n\nstruct DiscPoint {\n    float4 position [[position]];\n    float2 local;\n};\n\n// Reduce Transparency: a solid disc of the logo's charcoal behind the d20.\nvertex DiscPoint particlesDiscVertex(uint id [[vertex_id]], constant Uniforms& u [[buffer(0)]]) {\n    float2 corner = float2((id & 1u) ? 1.0 : -1.0, (id & 2u) ? 1.0 : -1.0);\n    float shortest = min(u.geometry.x, u.geometry.y);\n    float2 aspect = shortest / u.geometry.xy;\n    DiscPoint out;\n    out.position = float4(corner * u.phases.z * aspect, 0.9, 1.0);\n    out.local = corner;\n    return out;\n}\n\nfragment float4 particlesDiscFragment(DiscPoint point [[stage_in]]) {\n    float d = length(point.local);\n    float a = 1.0 - smoothstep(1.0 - max(fwidth(d), 1e-3), 1.0, d);\n    return float4(kDisc * a, a);\n}",
